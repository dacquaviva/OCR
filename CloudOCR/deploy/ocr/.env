# TRITON
TRITON_HOST=inference-tritonserver
TRITON_PORT=8000
TRITON_ATTEMPTS=5

#TEXT DETECTOR
TEXT_DETECTOR_MODEL_NAME=text_detector
TEXT_DETECTOR_MODEL_INPUT_NAME=x
TEXT_DETECTOR_MODEL_OUTPUT_NAME=sigmoid_0.tmp_0
TEXT_DETECTOR_MODEL_DATATYPE=FP32

#TEXT RECOGNIZER 
TEXT_RECOGNIZER_MODEL_NAME=text_recognizer
TEXT_RECOGNIZER_MODEL_INPUT_NAME=x
TEXT_RECOGNIZER_MODEL_OUTPUT_NAME=softmax_2.tmp_0
TEXT_RECOGNIZER_MODEL_DATATYPE=FP32
